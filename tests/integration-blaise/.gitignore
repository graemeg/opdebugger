# Build + run artifacts — regenerated by run_tests.sh.
# Source of truth is the .pas / .commands / .expected triples + the harness.
*.actual
*.diff
*.compile.log
*.o
*.ssa

# Compiled test binaries (no extension): ignore everything, then re-include
# the tracked source/text files.
test_*_*
!test_*_*.pas
!test_*_*.commands
!test_*_*.expected
